{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Transcribe",
  "version": "1.5.0-beta.2",
  "identifier": "com.timmy.voicetotextapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Local Transcribe",
        "width": 900,
        "height": 620,
        "minWidth": 640,
        "minHeight": 460,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 16,
          "y": 28
        },
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "14.2"
    },
    "windows": {
      "wix": {
        "version": "1.5.0.2"
      }
    },
    "externalBin": [
      "binaries/local-transcribe-node"
    ],
    "copyright": "Copyright © 2026 TimmySheep",
    "resources": {
      "../../../LICENSE": "LICENSE",
      "../../../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    }
  }
}
